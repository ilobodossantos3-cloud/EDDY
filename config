# Allowlist de aplicações. Só estas podem ser abertas/fechadas pelo Eddy.
# Gera/atualiza com:  python scripts/scan_apps.py
# "exe" pode ser um nome no PATH, um caminho completo ou um URI (ms-settings:)
apps:
  calculadora: {exe: "calc.exe", aliases: ["calculator"]}
  bloco de notas: {exe: "notepad.exe", aliases: ["notepad"]}
  definições: {exe: "ms-settings:", aliases: ["settings", "configurações"]}
  explorador de ficheiros: {exe: "explorer.exe", aliases: ["explorador", "explorer", "ficheiros"]}
  chrome: {exe: "chrome.exe", aliases: ["google chrome"]}
  edge: {exe: "msedge.exe", aliases: ["microsoft edge"]}
  firefox: {exe: "firefox.exe", aliases: []}
  vscode: {exe: "code", aliases: ["visual studio code", "code"]}
  spotify: {exe: "spotify.exe", aliases: []}
  obsidian: {exe: "obsidian.exe", aliases: []}
  terminal: {exe: "wt.exe", aliases: ["windows terminal"]}
